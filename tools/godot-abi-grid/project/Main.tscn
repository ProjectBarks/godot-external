; DeltaSiblingOne is a bare Node on purpose, and it is the only non-CanvasItem in
; the scene. Godot caches the parent three times over: Node::data.parent,
; CanvasItem::parent_item and Control::data.parent_control. In a tree made only of
; Controls all three hold the SAME address for every parent/child pair, so
; pointer identity cannot separate them however many pairs it intersects -- the
; 4.5-release-single-dotnet run left node.parent with three surviving candidates
; (0x128, 0x420, 0x430) for exactly this reason. A child that is not a CanvasItem
; has no parent_item and no parent_control, so it holds its parent in one place
; only, and intersecting it against the Control pairs leaves Node::data.parent
; alone. Same tie-breaking job as AnchoredWide does for Data.anchor vs
; Data.offset; it has no geometry because a Node has none.
[node name="DeltaSiblingOne" type="Node" parent="AlphaPanel/BetaBranch/GammaNest"]

[node name="DeltaSiblingTwo" type="Control" parent="AlphaPanel/BetaBranch/GammaNest"]
offset_left = 300.0
offset_top = 50.0
offset_right = 367.0
offset_bottom = 113.0

[node name="VisibleTwin" type="Panel" parent="AlphaPanel/BetaBranch"]
offset_left = 30.0
offset_top = 350.0
offset_right = 301.0
offset_bottom = 489.0
visible = true

