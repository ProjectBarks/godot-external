; godot-abi-grid — authored ground truth for ABI calibration (docs/analysis.md §8.9)
;
; DO NOT hand-edit node geometry here or in Main.tscn without re-running
;   node gen-expected.mjs
; expected.json embeds a SHA-256 of Main.tscn and calibrate.mjs refuses to run
; against a stale expectation file.
;
; build.ps1 rewrites, per grid cell:
;   config/features       -> the target engine version + binding tags
;   [dotnet]              -> removed for gdscript cells
; It never edits this file in place; it patches a staged copy.

config_version=5

[application]

config/name="godot-abi-grid"
config/description="Authored ground-truth scene for Godot ABI calibration."
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.5", "C#", "GL Compatibility")
config/use_custom_user_dir=true
config/custom_user_dir_name="godot-abi-grid"
run/low_processor_mode=true

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/resizable=false
window/vsync/vsync_mode=0



project/assembly_name="GodotAbiGrid"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
